# Envío del formulario de contacto (SMTP de Microsoft 365).
# El buzón de SMTP_USER necesita "SMTP autenticado" activado en el Centro de administración de Microsoft 365.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@epsigconsultores.com
SMTP_PASS=
# Remitente (debe ser SMTP_USER o un buzón con permiso "Enviar como"). Si se omite, se usa SMTP_USER.
CONTACT_FROM=info@epsigconsultores.com
# Destinatario de las solicitudes.
CONTACT_TO=info@epsigconsultores.com
