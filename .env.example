# Envío del formulario de contacto por SMTP.
# Copia este archivo como .env.local (en local y en el servidor) y rellena SMTP_PASS.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@epsigconsultores.com
SMTP_PASS=
CONTACT_FROM=info@epsigconsultores.com
CONTACT_TO=info@epsigconsultores.com

# Alternativa sin contraseña (Microsoft 365 "Direct Send"): deja SMTP_USER/SMTP_PASS
# vacíos, usa SMTP_HOST=epsigconsultores-com.mail.protection.outlook.com y SMTP_PORT=25.
# Requiere salida por el puerto 25 y la IP del servidor en el SPF del dominio.
